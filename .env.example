PROJECT_NAME=SDG16 Intelligence Platform
ENVIRONMENT=development
LOG_LEVEL=INFO

ML_API_PORT=8000
BACKEND_PORT=8080
WEB_PORT=3000
ML_SERVICE_URL=http://ml-api:8000

RAW_DATA_DIR=/workspace/data/raw
CLEAN_DATA_DIR=/workspace/data/clean
KNOWLEDGE_DIR=/workspace/data/knowledge
ARTIFACT_DIR=/workspace/artifacts
MODEL_METADATA_PATH=/workspace/artifacts/linear_regression/metadata.json

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=sdg16_knowledge
RAG_CHUNKS_PATH=/workspace/data/knowledge/processed/chunks.jsonl
EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL=BAAI/bge-m3

PDF_INPUT_DIR=/workspace/data/knowledge/source
PDF_CHUNKS_OUTPUT=/workspace/data/knowledge/processed/chunks.jsonl
PDF_TEXT_OUTPUT_DIR=/workspace/data/knowledge/text
KNOWLEDGE_MANIFEST=/workspace/configs/knowledge_manifest.yaml
PDF_PARSE_STRATEGY=pypdf
PDF_TEXT_EXPORT_MODE=group

LLM_PROVIDER=ollama
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:4b

MINIO_ROOT_USER=sdg16
MINIO_ROOT_PASSWORD=change-this-password
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=sdg16-lake
